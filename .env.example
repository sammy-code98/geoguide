# ── Frontend (Vite — exposed to the browser, prefix with VITE_) ──────────────
# The frontend talks only to the internal backend. In dev, Vite proxies /api to
# the Express server; override VITE_API_URL only for a non-proxied deployment.
VITE_API_URL=/api
# During dev, Vite proxies /api to this target (defaults to localhost:5001).
VITE_API_PROXY_TARGET=http://localhost:5001

# ── Firebase (frontend — PUBLIC by design, not secrets) ──────────────────────
# The Firebase web config identifies the project; access is enforced by
# Firestore security rules, not by hiding these values. Copy them from the
# Firebase console: Project settings → Your apps → SDK setup & configuration.
# See docs/FIREBASE.md for full setup steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend (server-side only — NEVER prefixed with VITE_, never bundled) ─────
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173

# Country data (countries.dev — keyless public API)
REST_COUNTRIES_BASE_URL=https://countries.dev

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview

# Serpstack
SERPSTACK_API_KEY=

# OpenWeather
OPENWEATHER_API_KEY=

# ExchangeRate-API
EXCHANGERATE_API_KEY=
